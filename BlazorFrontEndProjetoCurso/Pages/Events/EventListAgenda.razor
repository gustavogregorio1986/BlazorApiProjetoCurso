<div class="mb-5" id="eventAgendaId"></div>

@inject IJSRuntime IJSRuntime;
@code{
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await IJSRuntime.InvokeVoidAsync("loadAgenda", "https://localhost:7253/api/Events");
        }
    }
}
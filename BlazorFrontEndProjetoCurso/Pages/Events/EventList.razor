@page "/events"

<div class="mb-30"> 
   <div class="col">
       <h1>Lista</h1>
   </div>
   <div class="form-check form-switch form-check-reverse">
       <input class="form-check-input" type="checkbox" @bind="showAgenda" role="switch" />
       <label class="form-check-label @(showAgenda ? "text-dark" : "text-secondary")">Calendario</label>
   </div>
</div>

@if(showAgenda)
{
    <EventListAgenda></EventListAgenda>
}
else
{
    <EventListTable></EventListTable>
}

@code{
    private bool showAgenda;
    

}